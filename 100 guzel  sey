function dayOfYear(date: Date) {
  const start = new Date(date.getFullYear(), 0, 0);
  const diff =
    date.getTime() -
    start.getTime() +
    (start.getTimezoneOffset() - date.getTimezoneOffset()) * 60 * 1000;
  const oneDay = 1000 * 60 * 60 * 24;
  return Math.floor(diff / oneDay);
}

function pickTodayReason() {
  const today = new Date();
  const idx = dayOfYear(today) % REASONS.length;
  return { text: REASONS[idx], index: idx };
}

function pickRandomReason(excludeIndex?: number) {
  if (REASONS.length === 1) return { text: REASONS[0], index: 0 };
  let idx = Math.floor(Math.random() * REASONS.length);
  if (excludeIndex != null) {
    let guard = 0;
    while (idx === excludeIndex && guard < 5) {
      idx = Math.floor(Math.random() * REASONS.length);
      guard++;
    }
  }
  return { text: REASONS[idx], index: idx };
}

function useIosStandaloneHint() {
  const [show, setShow] = useState(false);
  useEffect(() => {
    const ua = navigator.userAgent || "";
    const isIOS = /iPhone|iPad|iPod/i.test(ua);
    const isStandalone = (window.matchMedia && window.matchMedia('(display-mode: standalone)').matches) || (window as any).navigator.standalone;
    if (isIOS && !isStandalone) setShow(true);
  }, []);
  return { show };
}

